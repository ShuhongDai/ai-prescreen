{
  "name": "ai-prescreen",
  "version": "0.0.0",
  "private": true,
  "description": "Rule-based first-pass screener for telltale AI-generated wording in English drafts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "validate-lexicon": "node scripts/validate-lexicon.ts",
    "fetch-arxiv": "node scripts/fetch-arxiv.ts",
    "fire-rate": "node scripts/fire-rate.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
